{
  "name": "ui-vue",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "npm": ">=11.0.0",
    "node": ">=22.22.0"
  },
  "scripts": {
    "dev": "concurrently \"npm run start-devtools\" \"npm run serve\"",
    "serve": "vite",
    "build": "npm run build:full && npm run build:embed && npm run build:runtime",
    "build:full": "vite build",
    "build:embed": "vite build --mode embed",
    "build:runtime": "npm run build:runtime:prod && npm run build:runtime:dev && npm run build:runtime:base",
    "build:runtime:prod": "vite build --mode runtime",
    "build:runtime:dev": "vite build --mode runtimedev",
    "build:runtime:base": "vite build --mode base",
    "preview": "vite preview",
    "test": "npm run test:runtime && npm run test:vue:runtime",
    "test:vue:full": "vitest --run",
    "test:vue:runtime": "vitest --run --mode runtime",
    "test:runtime": "node --test \"runtime/tests/**/*.test.mjs\"",
    "coverage": "vitest run --coverage",
    "devtools": "conc \"vue-devtools\" \"npm run serve\"",
    "vue-devtools": "vue-devtools &",
    "start-devtools": "cd ../uidevtools && npm run start",
    "lint": "npm run lint:es",
    "lint:es": "eslint .",
    "lint:ox": "oxlint",
    "reset-eslint-cache": "npx eslint --cache --cache-location ./node_modules/.cache/eslint-cache --cache-strategy content ."
  },
  "dependencies": {
    "@floating-ui/vue": "1.1.11",
    "@originjs/vite-plugin-commonjs": "1.0.3",
    "@popperjs/core": "2.11.8",
    "@vitejs/plugin-vue": "6.0.7",
    "@vitest/coverage-v8": "4.1.10",
    "@vue/compiler-sfc": "3.5.39",
    "@vue/test-utils": "2.2.7",
    "eventemitter3": "5.0.4",
    "highlight.js": "11.11.1",
    "json5": "2.2.3",
    "meriyah": "7.1.0",
    "petite-vue-i18n": "11.4.4",
    "pinia": "3.0.4",
    "sass": "1.101.0",
    "sucrase": "3.35.1",
    "vite": "8.0.16",
    "vite-plugin-env-compatible": "2.0.1",
    "vitest": "4.1.10",
    "vue": "3.5.35",
    "vue-router": "5.1.0",
    "yaml": "2.9.0"
  },
  "devDependencies": {
    "@babel/core": "8.0.1",
    "@babel/eslint-parser": "8.0.1",
    "@typescript-eslint/scope-manager": "8.60.1",
    "@vue/devtools": "8.1.2",
    "concurrently": "9.2.4",
    "core-js": "3.49.0",
    "jsdom": "29.1.1",
    "lint-plugin-beamng": "file:devutils/lint-plugin-beamng",
    "sass-loader": "17.0.0",
    "ws": "8.21.0"
  },
  "optionalDependencies": {
    "eslint": "^10.8.0",
    "eslint-plugin-vue": "10.9.2",
    "oxlint": "1.68.0",
    "rollup-plugin-visualizer": "7.0.1"
  },
  "browserslist": [
    "chrome >= 145"
  ],
  "overrides": {
    "electron": "42.3.3",
    "esbuild": "0.28.1",
    "yauzl": "3.2.1"
  }
}
